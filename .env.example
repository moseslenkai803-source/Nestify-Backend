APP_NAME=Nestify Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://nestify_app:your_password_here@localhost:5432/nestify
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# Outbox encryption key ring (JSON mapping version to Fernet key).
# Generate a key with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Supply real keys through your deployment secret manager or local .env.
OUTBOX_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_A_REAL_FERNET_KEY"}
OUTBOX_ACTIVE_ENCRYPTION_KEY_VERSION=v1
